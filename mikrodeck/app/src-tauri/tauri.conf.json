{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MikroDeck",
  "version": "1.0.0",
  "identifier": "io.github.thryki.mikrodeck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MikroDeck",
        "width": 1200,
        "height": 740,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Thryki",
    "copyright": "Copyright (C) 2026 Davi Reis Aragao (Thryki). Licenciado sob a GPL-3.0.",
    "shortDescription": "Seu Maschine Mikro MK3 como controlador de atalhos",
    "longDescription": "Transforma o Native Instruments Maschine Mikro MK3 num controlador de atalhos: pads com acoes e cores, paginas, os botoes fisicos, o knob, a touch strip e a tela. Fala HID direto com o aparelho, sem driver da fabricante, e convive com o Maschine 2.",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "binarios": ""
    },
    "windows": {
      "nsis": {
        "headerImage": "instalador/cabecalho.bmp",
        "sidebarImage": "instalador/lateral.bmp",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "bannerPath": "instalador/faixa.bmp",
        "dialogImagePath": "instalador/abertura.bmp"
      }
    }
  }
}